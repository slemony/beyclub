# Copy to `.env` for local development. Both values have sensible defaults, so
# you only need this file to point at a different (e.g. staging) bucket.

# Where the app fetches its dataset JSON at runtime. Baked into the build by
# Vite. Defaults to the production Firebase Storage bucket — test and production
# intentionally share the same data, so leave this alone unless you are building
# against a separate bucket.
VITE_DATA_BASE_URL=https://storage.googleapis.com/beyclub.firebasestorage.app/

# Bucket the data scripts (data:pull / data:push) read from and write to.
DATA_BUCKET=beyclub.firebasestorage.app
