# Copy to `.env` for local development. Both values have sensible defaults, so
# you only need this file to point at a different (e.g. staging) data site.

# Where the app fetches its dataset JSON at runtime. Baked into the build by
# Vite. Defaults to the production data site (the project's free default Firebase
# Hosting site) — test and production intentionally share the same data, so leave
# this alone unless you are building against a separate data site.
VITE_DATA_BASE_URL=https://beyclub-90e95.web.app/

# Where the data scripts (data:pull) read the current snapshots from. Same site.
DATA_BASE_URL=https://beyclub-90e95.web.app/
