# Firebase web config for the collection tracker's Google sign-in and sync.
# Copy this file to .env.local (already gitignored via *.local) and fill in
# the values from your own Firebase project's web app config. Leave it
# missing/unset to run the app with the collection tracker local-only and the
# sign-in button hidden — nothing else in the app needs these.
#
# Setup: console.firebase.google.com → create a project → Authentication →
# enable the Google sign-in provider → Firestore Database → create a
# database → Project settings → your web app's config values below.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
