rules_version = '2';

// Rules for Firebase SDK access to the bucket. The web app does NOT use the SDK
// — it reads the datasets over their plain public URLs, whose read access is
// granted separately by IAM (allUsers → Storage Object Viewer; see
// docs/firebase-migration.md). These rules exist so that any future SDK client
// can read the datasets but never write them: writes come only from the
// scraper's service account, which bypasses rules entirely.
service firebase.storage {
  match /b/{bucket}/o {
    match /data/{file} {
      allow read: if true;
      allow write: if false;
    }
  }
}
